---
import Icon from './Icon.astro';
import type { CourseGroup } from '../data/profile';

interface Props {
  role: string;
  org: string;
  period: string;
  type?: string;
  location?: string;
  description?: string;
  courses?: CourseGroup[];
  repo?: string;
}

const { role, org, period, type, location, description, courses, repo } = Astro.props;
---

<li class="reveal relative pl-8 sm:pl-10">
  <span
    class="absolute -left-[7px] top-1.5 size-3 rounded-full border-2 border-teal bg-paper"
    aria-hidden="true"></span>
  <p class="font-mono text-xs tracking-widest text-teal-deep uppercase">{period}</p>
  <h3 class="mt-1.5 font-display text-lg font-semibold text-ink">{role}</h3>
  <p class="mt-0.5 text-sm text-steel">
    {org}{type && <> · <span class="font-mono text-xs">{type}</span></>}
  </p>
  {location && <p class="mt-0.5 font-mono text-xs text-steel/80">{location}</p>}
  {
    description && (
      <p class="mt-2 max-w-prose text-[15px] leading-relaxed text-steel">{description}</p>
    )
  }
  {
    courses && (
      <div class="mt-3 space-y-3">
        {courses.map((group) => (
          <div>
            {group.label && <p class="font-mono text-xs text-teal-deep">{group.label}</p>}
            <ul class="mt-1.5 flex max-w-prose flex-wrap gap-2">
              {group.items.map((course) => (
                <li class="rounded-full border border-line bg-white/70 px-2.5 py-0.5 font-mono text-[11px] text-steel">
                  {course}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }
  {
    repo && (
      <a
        href={repo}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex items-center gap-1 font-mono text-[13px] text-teal-deep underline decoration-teal/30 underline-offset-4 transition-colors hover:text-teal hover:decoration-teal"
      >
        {repo.replace('https://github.com/', '')}
        <Icon name="arrow-up-right" class="size-3.5" />
      </a>
    )
  }
</li>
