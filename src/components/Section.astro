---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  tinted?: boolean;
}

const { id, eyebrow, title, tinted = false } = Astro.props;
---

<section
  id={id}
  class:list={['scroll-mt-20 border-t border-line py-16 md:py-24', tinted && 'bg-mist/60']}
>
  <div class="mx-auto w-full max-w-5xl px-5 sm:px-8">
    <div class="reveal">
      <p class="font-mono text-sm text-teal-deep">
        <span class="select-none text-steel">$ </span>{eyebrow}
      </p>
      <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-balance text-ink md:text-4xl">
        {title}
      </h2>
    </div>
    <div class="mt-10 md:mt-12">
      <slot />
    </div>
  </div>
</section>
