---
import Icon from './Icon.astro';

interface Props {
  name: string;
  description: string;
  href: string;
  tags: string[];
  icon: string;
}

const { name, description, href, tags, icon } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative flex h-full flex-col rounded-xl border border-line bg-white/70 p-6 shadow-sm transition-all duration-200 hover:border-teal/60 hover:shadow-md motion-safe:hover:-translate-y-1"
>
  <div class="flex items-start justify-between gap-4">
    <span class="inline-flex size-10 items-center justify-center rounded-lg bg-mist text-teal">
      <Icon name={icon} class="size-5" />
    </span>
    <Icon
      name="arrow-up-right"
      class="size-4 text-steel transition-colors group-hover:text-teal"
    />
  </div>
  <h3 class="mt-4 font-mono text-base font-semibold text-ink">{name}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-steel">{description}</p>
  <p class="mt-3 font-mono text-xs text-steel/80">
    {href.replace('https://github.com/', '')}
  </p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      tags.map((tag) => (
        <li class="rounded-full border border-line bg-mist px-2.5 py-0.5 font-mono text-[11px] text-steel">
          {tag}
        </li>
      ))
    }
  </ul>
</a>
